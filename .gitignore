# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
# pubspec.lock is tracked: the workspace builds applications, and every export must resolve the
# same versions (sqlite3's build hook fetches the SQLite binary that matches its own version).
*.g.dart
*.freezed.dart

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# 🔴 مفاتيحُ حساب خدمة Firebase — أينما وقعت.
#
# القاعدةُ بالنمط لا بالمسار عمداً: الملفُّ يُحمَّل من لوحة Firebase باسمٍ مولَّد
# (`<project>-firebase-adminsdk-<hash>.json`) ويُنسَخ يدوياً، فيقع مرّةً في
# `backend/app/` ومرّةً في جذر الباك إند — وكلاهما مجلدٌ متتبَّع. وقع ذلك فعلاً
# في م.7.4، والحارسُ ههنا يمنع تكراره بدل أن يُكتشَف عند المراجعة.
*firebase-adminsdk*.json
firebase-credentials.json

# مخرجاتُ scripts/export-apps.ps1
dist/

# Brand identity source delivered by the designer (videos, mock-ups, reference images: 24MB).
# Generated outputs are committed; scripts/build-*.mjs|py read from it.
/brand-v3/

# بيانات المعاهد الحقيقية (أسماء وأرقام) — لا تدخل المستودع
temp data/

# The marketing campaigns (renders, videos, screenshots) are large and regenerated from marketing/campaign-*/_source.
/marketing/
