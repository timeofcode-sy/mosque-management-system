<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- خادمُ التطوير (php artisan serve) يعمل بـHTTP صريح على 10.0.2.2:8000،
         وأندرويد 9+ يمنع الاتصال غير المشفَّر افتراضياً. مقصورٌ على بناء الـdebug
         عمداً: بناءُ الإصدار يبقى على المنع، فلا ينشأ عنه تراخٍ في الإنتاج. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
